<keyboard3 xmlns="https://schemas.unicode.org/cldr/45/keyboard3" conformsTo="45" locale="fr">
    <info author="CoreRectH, from the k3lp QWERTZ layout by Lars Mühlbauer" name="French (AZERTY)" layout="AZERTY" indicator="FR" />

    <displays>
        <display keyId="base" display="${base_display}" />
        <display keyId="base-to-shift" display="@fl:icon/shift" />
        <display keyId="shift-to-base" display="@fl:icon/shift" />
        <display keyId="symbol-1" display="${symbol_1_display}" />
        <display keyId="symbol-2" display="${symbol_2_display}" />
        <display keyId="numeric" display="${numeric_display}" />
        <display keyId="base-numeric" display="${base_display}" />
        <display keyId="symbols-numeric" display="${symbol_1_display}" />
        <display keyId="space-numeric" display="@fl:icon/space_bar" />
    </displays>

    <keys>
        <import base="cldr" path="45/keys-Zyyy-punctuation.xml" />
        <import base="cldr" path="45/keys-Zyyy-currency.xml" />

        <key id="base" layerId="base" width="1.5" />
        <key id="base-to-shift" layerId="shift" width="1.5" />
        <key id="shift-to-base" layerId="base" width="1.5" />
        <key id="numeric" layerId="numeric" />
        <key id="symbol-1" layerId="symbol-1" width="1.5" />
        <key id="symbol-2" layerId="symbol-2" width="1.5" />

        <key id="bksp" output="@k3:action/backspace" stretch="true" />
        <key id="enter" output="@k3:action/enter" width="1.6" />
        <key id="space-no-stretch" output="\u{0020}" />
        <key id="bksp-no-stretch" output="@k3:action/backspace" />

        <!-- Numbers -->
        <key id="0" output="0" />
        <key id="1" output="1" />
        <key id="2" output="2" />
