{
  "permissions": {
    "allow": [
      "Bash(git push --force-with-lease=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-ci-before-push.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
